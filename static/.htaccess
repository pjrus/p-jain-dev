RewriteEngine On

# The SvelteKit build writes one .html file per route (blog.html,
# blog/my-post.html), so clean URLs map straight onto them.

# Drop trailing slashes so /blog/ and /blog resolve to the same page
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# Remove .html extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Redirect requests with .html to clean URLs (for SEO)
RewriteCond %{THE_REQUEST} \s(.+)\.html\s [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Prerendered fallback document for unknown paths
ErrorDocument 404 /404.html
